NODE_ENV=development
DATABASE_ENVIRONMENT=development
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@DEV_NEON_HOST/neondb?sslmode=require"
# Hostname only. Never paste a complete URL or credentials here.
PRODUCTION_DATABASE_HOST="PROD_NEON_HOST"
JWT_SECRET="min-12-chars-secret"
# DEV only. Never set in production. Required together with CLI --confirm to run operational reset.
# ALLOW_DEV_OPERATIONAL_RESET=YES
# Enable only for the AVIAT trial and initial load. Must return to false after Hugo approves the load.
# ALLOW_TENANT_INVENTORY_RESET=false
