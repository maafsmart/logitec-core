generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  fullName            String
  role                String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  comments            Comment[]
  scanEvents          ScanEvent[]
  inventoryMovements  InventoryMovement[]
}

model Comment {
  id          String   @id @default(cuid())
  body        String
  entityType  String?
  entityId    String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}

model Product {
  id                  String               @id @default(cuid())
  customerId          String?
  sku                 String               @unique
  barcode             String?              @unique
  name                String
  description         String?
  unit                String               @default("EA")
  serialControlled    Boolean              @default(false)
  lotControlled       Boolean              @default(false)
  warehouse           String               @default("TULTITLAN24")
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer?            @relation(fields: [customerId], references: [id])
  scanEvents          ScanEvent[]
  inventoryStocks     InventoryStock[]     // legacy compatibility
  inventoryMovements  InventoryMovement[]
  inventories         Inventory[]

  @@index([customerId])
}

model InventoryStock {
  id         String   @id @default(cuid())
  productId  String
  warehouse  String
  quantity   Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouse])
  @@index([warehouse])
}

model InventoryMovement {
  id              String   @id @default(cuid())
  productId       String
  type            String   @default("ADJUSTMENT")
  warehouse       String?
  qty             Decimal  @default(0) @db.Decimal(18, 4)
  fromLocationId  String?
  toLocationId    String?
  movementType    String
  quantityBefore  Decimal  @db.Decimal(18, 4)
  quantityAfter   Decimal  @db.Decimal(18, 4)
  reference       String?
  notes           String?
  userId          String
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation    Location? @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation      Location? @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([userId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model ScanEvent {
  id          String   @id @default(cuid())
  scannedCode String
  result      String
  userId      String
  productId   String?
  warehouse   String?
  location    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])

  @@index([userId, createdAt])
  @@index([scannedCode])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Location {
  id               String              @id @default(cuid())
  warehouse        String
  zone             String
  rack             String
  level            String
  position         String
  code             String              @unique
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  inventories      Inventory[]
  movementsFrom    InventoryMovement[] @relation("MovementFrom")
  movementsTo      InventoryMovement[] @relation("MovementTo")

  @@index([warehouse])
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  locationId  String
  qty         Decimal   @default(0) @db.Decimal(18, 4)
  reservedQty Decimal   @default(0) @db.Decimal(18, 4)
  status      String    @default("AVAILABLE")
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId, status])
  @@index([locationId, status])
}
