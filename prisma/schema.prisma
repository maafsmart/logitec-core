generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  fullName            String
  role                String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  comments            Comment[]
  scanEvents          ScanEvent[]
  inventoryMovements  InventoryMovement[]
}

model Comment {
  id          String   @id @default(cuid())
  body        String
  entityType  String?
  entityId    String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}

model Product {
  id                  String               @id @default(cuid())
  sku                 String               @unique
  barcode             String?              @unique
  name                String
  warehouse           String               @default("TULTITLAN24")
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  scanEvents          ScanEvent[]
  inventoryStocks     InventoryStock[]
  inventoryMovements  InventoryMovement[]
}

model InventoryStock {
  id         String   @id @default(cuid())
  productId  String
  warehouse  String
  quantity   Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouse])
  @@index([warehouse])
}

model InventoryMovement {
  id              String   @id @default(cuid())
  productId       String
  warehouse       String
  movementType    String
  quantityBefore  Decimal  @db.Decimal(18, 4)
  quantityAfter   Decimal  @db.Decimal(18, 4)
  reference       String?
  notes           String?
  userId          String
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([userId])
}

model ScanEvent {
  id          String   @id @default(cuid())
  scannedCode String
  result      String
  userId      String
  productId   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])

  @@index([userId, createdAt])
  @@index([scannedCode])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
